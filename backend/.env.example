DATABASE_URL=sqlite:///./love_letters.db
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LETTER_ENCRYPTION_KEY=generate-with-fernet-generate-key
FRONTEND_ORIGIN=http://localhost:3000
# In production, add your Vercel URL too, comma-separated, e.g.:
# FRONTEND_ORIGIN=http://localhost:3000,https://love-letters-frontend.vercel.app
